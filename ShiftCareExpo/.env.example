const { getDefaultConfig } = require('expo/metro-config');

const config = getDefaultConfig(__dirname);

// Supabase's dependency chain ships a "package exports" field that points
// Metro at Node-only code (which uses private class fields Hermes can't run)
// instead of the React Native-safe build. Disabling this makes Metro fall
// back to the main/browser fields instead, which work correctly on-device.
config.resolver.unstable_enablePackageExports = false;

module.exports = config;